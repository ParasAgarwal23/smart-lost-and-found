<mxCell id="id88" value="Legend&lt;br&gt;Each arrow: FK row &amp;#8594; the PK row it references&lt;br&gt;Arrow color = which table the FK belongs to:&lt;br&gt;&lt;span style=&quot;color:#B22222;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;LOST_REPORT&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#C2410C;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;FOUND_REPORT&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#6D28D9;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;CLAIM&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#0E7490;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;HANDOVER&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#15803D;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;MATCHES&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#A16207;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;CLAIM_EVIDENCE&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#BE185D;font-weight:bold;&quot;&gt;&amp;#9632;&lt;/span&gt;&amp;nbsp;FOUND_PHOTOS&amp;nbsp;&amp;nbsp; " style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1180" y="460" width="340" height="150" as="geometry" /></mxCell>
