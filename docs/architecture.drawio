<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Architecture - Smart Lost and Found Management System" id="architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Smart Lost and Found Management System - application and database architecture&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1100" height="34" as="geometry" />
        </mxCell>

        <!-- Browser -->
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;Visitor (anonymous) &amp;middot; USER &amp;middot; ADMIN&lt;br&gt;&lt;br&gt;Home, Search (exact words / similar meaning),&lt;br&gt;Create Account, Sign In, Lost/Found report forms,&lt;br&gt;My Reports (edit, delete), Possible matches,&lt;br&gt;My Claims, Evidence, Handover,&lt;br&gt;Campus Summary (ADMIN only)&lt;br&gt;&lt;br&gt;&lt;i&gt;Encrypted HTTP-only session cookie holds only User_ID&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EEE7;strokeColor=#0F5C48;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="320" height="230" as="geometry" />
        </mxCell>

        <!-- Next.js server -->
        <mxCell id="next" value="&lt;b&gt;Next.js 16 server (App Router, Node.js runtime)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F4EF;strokeColor=#17211D;strokeWidth=2;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="560" height="570" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="&lt;b&gt;Server Components (pages)&lt;/b&gt;&lt;br&gt;read data through query()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F5C48;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="actions" value="&lt;b&gt;Server Actions&lt;/b&gt; (app/actions)&lt;br&gt;register, login/logout, lost/found report, edit,&lt;br&gt;delete report, claim, withdraw, evidence, handover&lt;br&gt;Zod validation on the server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F5C48;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="100" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;lib/auth.ts, lib/session.ts, lib/password.ts&lt;/b&gt;&lt;br&gt;iron-session cookie &amp;rarr; User_ID; role re-read from PostgreSQL&lt;br&gt;on every request (auth_session_user); Argon2id verify/hash;&lt;br&gt;requireRole(&quot;ADMIN&quot;) for admin pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF0D6;strokeColor=#744800;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="embed" value="&lt;b&gt;lib/embedding.ts&lt;/b&gt;&lt;br&gt;Transformers.js all-MiniLM-L6-v2, CPU&lt;br&gt;mean pooling, normalised &amp;rarr; 384 values&lt;br&gt;(reports and search text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EDF6;strokeColor=#2B5B8A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="semantic" value="&lt;b&gt;lib/semantic-search.ts&lt;/b&gt;&lt;br&gt;ORDER BY Embedding &amp;lt;=&amp;gt; query LIMIT k&lt;br&gt;(HNSW-compatible, both report tables)&lt;br&gt;&lt;b&gt;lib/search.ts&lt;/b&gt; exact words (ILIKE + CTE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EDF6;strokeColor=#2B5B8A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="310" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;lib/db.ts&lt;/b&gt; - web pool (DATABASE_URL = lf_web)&lt;br&gt;every query = one transaction:&lt;br&gt;BEGIN; set_config('role', lf_anon | lf_user, true);&lt;br&gt;set_config('app.user_id', &amp;lt;session User_ID&amp;gt;, true); ...; COMMIT&lt;br&gt;&lt;i&gt;transaction-local, so pooled connections never leak identity&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17211D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="admindb" value="&lt;b&gt;lib/admin-db.ts&lt;/b&gt; - requireRole(&quot;ADMIN&quot;) first, then the admin pool&lt;br&gt;(ADMIN_DATABASE_URL = lf_admin_web), READ ONLY transaction, role lf_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432B;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="525" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nextnote" value="No credentials in source: DATABASE_URL, ADMIN_DATABASE_URL and SESSION_SECRET come from the git-ignored .env.local." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="585" width="520" height="30" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 18 + pgvector 0.8.6 extension (one server)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#1F4E79;strokeWidth=2;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="60" width="570" height="780" as="geometry" />
        </mxCell>
        <mxCell id="logins" value="&lt;b&gt;Login roles&lt;/b&gt; (NOINHERIT, not superuser, no BYPASSRLS)&lt;br&gt;lf_web &amp;rarr; may SET ROLE lf_anon or lf_user only&lt;br&gt;lf_admin_web &amp;rarr; may SET ROLE lf_admin only (read-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="100" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="privroles" value="&lt;b&gt;Privilege roles&lt;/b&gt; (GRANT / REVOKE, column-level)&lt;br&gt;lf_anon: public report columns, auth/registration functions&lt;br&gt;lf_user (inherits lf_anon): own reports, claims, evidence, receipts&lt;br&gt;lf_admin: admin_* views and admin_daily_activity only&lt;br&gt;PUBLIC: nothing (database, schema, tables, functions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="185" width="530" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rls" value="&lt;b&gt;Row-Level Security&lt;/b&gt; on LOST_REPORT, FOUND_REPORT, CLAIM, HANDOVER, CLAIM_EVIDENCE&lt;br&gt;owner = &quot;User_ID&quot; = app_current_user_id(); 19 policies&lt;br&gt;(any user may lock a found report; only its owner may change it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE8E1;strokeColor=#B4432B;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="295" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="definer" value="&lt;b&gt;SECURITY DEFINER functions&lt;/b&gt; (NOLOGIN owners, fixed search_path)&lt;br&gt;lf_auth: auth_credentials, auth_session_user, register_user (role = 'USER')&lt;br&gt;lf_reporting: found_report_has_handover, found_report_claim_count,&lt;br&gt;admin_* views, admin_daily_activity (WITH RECURSIVE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF0D6;strokeColor=#744800;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="380" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="procs" value="&lt;b&gt;Procedures (CALL)&lt;/b&gt;: withdraw_claim, delete_own_report&lt;br&gt;&lt;b&gt;Functions&lt;/b&gt;: get_claim_summary, find_potential_matches&lt;br&gt;&lt;b&gt;Trigger&lt;/b&gt;: invalidate_report_embedding (BEFORE UPDATE)&lt;br&gt;&lt;b&gt;Views&lt;/b&gt;: v_lost_report_details, v_found_report_details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="475" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tables" value="&lt;b&gt;Ten relations&lt;/b&gt;: USER, CATEGORY, LOCATION, LOST_REPORT, FOUND_REPORT,&lt;br&gt;FOUND_PHOTOS, MATCHES, CLAIM, CLAIM_EVIDENCE, HANDOVER&lt;br&gt;PK/FK, UNIQUE, CHECK, NOT NULL, DEFAULT CURRENT_DATE,&lt;br&gt;ON DELETE CASCADE (MATCHES, FOUND_PHOTOS), NO ACTION elsewhere" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EEE7;strokeColor=#0F5C48;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="570" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vector" value="&lt;b&gt;pgvector&lt;/b&gt;: &quot;Embedding&quot; VECTOR(384) in LOST_REPORT and FOUND_REPORT&lt;br&gt;cosine distance &amp;lt;=&amp;gt;; HNSW indexes (vector_cosine_ops) on both tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EDF6;strokeColor=#2B5B8A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="665" width="530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="owner" value="&lt;b&gt;Table owner&lt;/b&gt; (postgres) - MAINTENANCE_DATABASE_URL only: migrations, provision:admin,&lt;br&gt;embedding backfill, test fixtures. Never used by the Next.js application." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="745" width="530" height="70" as="geometry" />
        </mxCell>

        <!-- Maintenance -->
        <mxCell id="maint" value="&lt;b&gt;Maintenance terminal&lt;/b&gt;&lt;br&gt;psql db/*.sql (setup, migrations, verify)&lt;br&gt;npm run provision:admin&lt;br&gt;npm run db:backfill-embeddings&lt;br&gt;npm test (smart_lost_found_test only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="700" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="HTTPS requests, forms&lt;br&gt;(Server Actions)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#0F5C48;fontSize=11;" edge="1" parent="1" source="browser" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="lf_web connection&lt;br&gt;(role per transaction)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#17211D;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="logins">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="lf_admin_web&lt;br&gt;(read-only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#B4432B;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="admindb" target="definer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="owner connection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;dashed=1;strokeColor=#999999;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="maint" target="owner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flowtitle" value="&lt;b&gt;Registration and sign-in flow&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="flow" value="1. Create Account form &amp;rarr; register action (Zod)&lt;br&gt;2. Argon2id hash in Node.js (lib/password.ts)&lt;br&gt;3. SELECT register_user(name, email, phone, hash)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;as lf_anon &amp;rarr; INSERT with Role = 'USER'&lt;br&gt;4. Redirect to Sign In&lt;br&gt;5. auth_credentials(email) &amp;rarr; Argon2id verify&lt;br&gt;6. Sealed cookie {User_ID}; role re-read each&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;request via auth_session_user()&lt;br&gt;ADMIN accounts: provision:admin (owner only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#744800;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="360" width="320" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
