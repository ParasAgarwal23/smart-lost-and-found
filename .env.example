# Required for server-side PostgreSQL queries. Set in an ignored .env.local.
# Format: postgresql://<username>:<URL-encoded-password>@<host>:<port>/<database>
# Keep this private; never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=

# Required for authentication sessions: an independently generated random secret.
# At least 32 characters. Set privately in .env.local; never use NEXT_PUBLIC_.
# Production must use HTTPS because the session cookie is Secure there.
SESSION_SECRET=
