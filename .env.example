# Copy to the ignored .env.local and fill privately. Never commit real values
# and never use a NEXT_PUBLIC_ prefix for any of these.
# Format: postgresql://<username>:<URL-encoded-password>@<host>:<port>/<database>

# Web application login: the least-privilege role lf_web (db/roles.sql).
# Never the postgres superuser.
DATABASE_URL=

# Admin analytics login: lf_admin_web (read-only), used only by lib/admin-db.ts.
ADMIN_DATABASE_URL=

# Table-owner connection (e.g. postgres) for migrations, npm run provision:admin,
# npm run db:backfill-embeddings and test fixtures. Never read by the Next.js app.
MAINTENANCE_DATABASE_URL=

# Required for authentication sessions: an independently generated random secret.
# At least 32 characters. Production must use HTTPS because the session cookie is Secure there.
SESSION_SECRET=
